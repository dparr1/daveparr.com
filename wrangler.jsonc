// Cloudflare Worker that serves the built Jekyll site from _site/.
// `npx wrangler deploy` runs the build command first, then uploads _site/.
{
  "name": "daveparr-com",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "bundle install && bundle exec jekyll build"
  },
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  // Required by `npx wrangler preview`, which Workers Builds runs for
  // non-production branches (PR previews). Empty means previews use the
  // settings above.
  "previews": {}
}
